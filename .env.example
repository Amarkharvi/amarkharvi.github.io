# Optional: inquiries posted to /api/inquiry (and LUT sale notifications) are forwarded here as JSON
# (Slack/Discord/Zapier/your own endpoint). When unset, they are only logged server-side.
INQUIRY_WEBHOOK_URL=

# LUT shop — Razorpay (https://dashboard.razorpay.com/app/keys). Use rzp_test_ keys until your account is activated.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when adding the webhook (Dashboard → Webhooks → URL: https://<your-domain>/api/shop/webhook)
RAZORPAY_WEBHOOK_SECRET=

# Signs download links after payment. At least 32 random characters, e.g. `openssl rand -base64 48`.
DOWNLOAD_TOKEN_SECRET=

# Admin page (/admin) — lets Amar edit films, products, stack, and site text without redeploying.
# Pick any password. Generate the secret with `openssl rand -base64 48` (at least 32 characters).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
