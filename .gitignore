# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*
!.env.example

# editor / tooling
.history/
.cursor/
.vscode/
.claude/
sftp.json
sftp-config.json

# vercel
.vercel

# admin-edited content and uploads — persist these on the server across deploys,
# don't let a fresh `git clone`-based deploy wipe them.
/content/*.json
/public/media/uploads/*
!/public/media/uploads/.gitkeep

# paid LUT files stay on the server; this repo is public
/private/

# typescript
*.tsbuildinfo
next-env.d.ts
